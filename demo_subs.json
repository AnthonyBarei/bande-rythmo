{"subtitles":[{"start":0.4,"end":2.1,"character":"Anna","text":"Tu m'entends ?"},{"start":2.4,"end":4.6,"character":"Marc","text":"À peine. Reste où tu es."},{"start":4.9,"end":7.2,"character":"Anna","text":"Je ne peux pas, ça lâche."},{"start":7.5,"end":10.0,"character":"Marc","text":"Donne-moi ta main."},{"start":10.4,"end":13.1,"character":"Anna","text":"Tiens bon, j'arrive."},{"start":13.4,"end":15.5,"character":"Marc","text":"Doucement..."}]}
